---
import BaseLayout from "~/components/BaseLayout.astro";
import Section from "~/components/Section.astro";
import FeatureGrid from "~/components/FeatureGrid.astro";
import CallToAction from "~/components/CallToAction.astro";
---

<BaseLayout
  title="TrueNAS SCALE iOS App Features"
  description="Explore TrueNAS Pulse features for TrueNAS SCALE monitoring on iPhone: live health, alerts, storage visibility, widgets, Control Mode actions, Free, and Pro."
>
  <Section
    eyebrow="The complete inventory"
    heading="Know what is happening. Act with care."
    headingLevel="h1"
    lede="Free includes two servers, live health, alerts, storage visibility, one local monitor, and 1-hour reporting. Pro adds fleet comparison, longer history, and advanced guarded controls. Each feature below shows its tier."
  >
    <p class="mb-8 text-sm leading-relaxed text-text-secondary">
      Snapshot creation and alert acknowledgement are included in Free.
      <a href="/pro" class="ml-1 text-accent underline underline-offset-4 hover:text-accent-hover">Compare Free and Pro</a>
      before choosing the one-time upgrade.
    </p>
    <FeatureGrid withHeadings />
  </Section>

  <CallToAction />
</BaseLayout>
