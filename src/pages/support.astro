---
import BaseLayout from "~/components/BaseLayout.astro";
import Section from "~/components/Section.astro";
import { site } from "~/data/site";
---

<BaseLayout
  title="Support"
  description="Report a bug or send feedback for TrueNAS Pulse by email. We read every message."
>
  <Section eyebrow="Get help" heading="Report a bug or send feedback." headingLevel="h1" width="narrow">
    <div class="space-y-8">

      <!-- Form -->
      <form
        id="support-form"
        data-support-email={site.supportEmail}
        class="space-y-5 rounded-2xl border border-stroke-soft bg-surface p-7"
        novalidate
      >
        <!-- Category -->
        <div>
          <label for="category" class="mb-1.5 block text-sm font-medium text-text">
            Category <span class="text-accent">*</span>
          </label>
          <select
            id="category"
            name="category"
            required
            class="min-h-11 w-full rounded-lg border border-stroke-soft bg-bg px-3 py-2.5 text-sm text-text transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          >
            <option value="" disabled selected>Choose a category…</option>
            <option value="bug">Bug report — something is broken</option>
            <option value="feature-request">Feature request — something I'd love to see</option>
            <option value="feedback">General feedback</option>
            <option value="question">Question about the app</option>
          </select>
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="mb-1.5 block text-sm font-medium text-text">
            Description <span class="text-accent">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            rows="6"
            required
            minlength="10"
            maxlength="1800"
            aria-describedby="char-count support-privacy"
            placeholder="Describe the issue or feedback in as much detail as you like. For bugs: what you expected, what happened, and steps to reproduce help a lot."
            class="w-full resize-y rounded-lg border border-stroke-soft bg-bg px-3 py-2.5 text-sm text-text placeholder:text-text-secondary/50 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          ></textarea>
          <p id="char-count" class="mt-1 text-right text-xs text-text-secondary">0 / 1800</p>
        </div>

        <!-- App version -->
        <div>
          <label for="app_version" class="mb-1.5 block text-sm font-medium text-text">
            App version <span class="text-text-secondary font-normal">(optional)</span>
          </label>
          <input
            type="text"
            id="app_version"
            name="app_version"
            placeholder={`e.g. ${site.latestVersion}`}
            maxlength="20"
            class="min-h-11 w-full rounded-lg border border-stroke-soft bg-bg px-3 py-2.5 text-sm text-text placeholder:text-text-secondary/50 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          />
          <p class="mt-1 text-xs text-text-secondary">Settings → About in the app.</p>
        </div>

        <!-- Error banner -->
        <div
          id="form-error"
          role="alert"
          class="hidden rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400"
        ></div>

        <p id="support-privacy" class="text-sm leading-relaxed text-text-secondary">
          Send opens your email app with a message to
          <a href={`mailto:${site.supportEmail}`} class="text-accent hover:text-accent-hover">{site.supportEmail}</a>,
          ready to review and send. Please leave out API tokens, passwords, and other secrets.
        </p>

        <!-- Submit -->
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-text px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Send by email
        </button>
      </form>

      <!-- Success state (hidden until submit) -->
      <div
        id="success-panel"
        class="hidden rounded-2xl border border-green-500/30 bg-green-500/10 px-7 py-8 text-center"
      >
        <div class="mb-3 text-3xl">✓</div>
        <h2 class="mb-2 text-lg font-semibold text-text">Your email is ready to send.</h2>
        <p class="text-sm text-text-secondary">
          Review it in your email app and press send. Every message gets read; expect a reply within a couple of days.
          If nothing opened, email <a href={`mailto:${site.supportEmail}`} class="text-accent hover:text-accent-hover">{site.supportEmail}</a> directly.
        </p>
        <button
          id="send-another"
          class="mt-5 min-h-11 rounded-lg px-3 text-sm text-accent transition-colors hover:text-accent-hover"
        >
          Write another
        </button>
      </div>

      <!-- Tips card -->
      <div class="rounded-xl border border-stroke-soft bg-surface p-7">
        <h3 class="mb-3 text-base font-semibold tracking-tight text-text">
          For bugs — this helps a lot
        </h3>
        <ul class="space-y-1.5 text-sm text-text-secondary">
          <li>iOS version + device model (Settings → General → About).</li>
          <li>TrueNAS Pulse version (Settings → About in the app).</li>
          <li>TrueNAS SCALE version of the affected server.</li>
          <li>Whether it reproduces in <em>Demo Mode</em> (Settings → Demo → Enter Demo Mode).</li>
          <li>A short description of steps to reproduce — even rough steps cut debug time in half.</li>
        </ul>
      </div>

    </div>
  </Section>
</BaseLayout>

<script>
  const form = document.getElementById("support-form") as HTMLFormElement;
  const successPanel = document.getElementById("success-panel") as HTMLDivElement;
  const errorBanner = document.getElementById("form-error") as HTMLDivElement;
  const charCount = document.getElementById("char-count") as HTMLParagraphElement;
  const textarea = document.getElementById("description") as HTMLTextAreaElement;
  const sendAnother = document.getElementById("send-another") as HTMLButtonElement;
  const supportEmail = form?.dataset.supportEmail ?? "support@truenaspulse.com";

  const categoryLabels: Record<string, string> = {
    bug: "Bug report",
    "feature-request": "Feature request",
    feedback: "Feedback",
    question: "Question",
  };

  textarea?.addEventListener("input", () => {
    const len = textarea.value.length;
    charCount.textContent = `${len} / 1800`;
    charCount.classList.toggle("text-red-400", len > 1700);
  });

  function showError(msg: string) {
    errorBanner.textContent = msg;
    errorBanner.classList.remove("hidden");
    errorBanner.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function clearError() {
    errorBanner.textContent = "";
    errorBanner.classList.add("hidden");
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearError();

    const data = new FormData(form);
    const category = (data.get("category") as string | null)?.trim();
    const description = (data.get("description") as string | null)?.trim();
    const appVersion = (data.get("app_version") as string | null)?.trim();

    if (!category) { showError("Please choose a category."); return; }
    if (!description || description.length < 10) { showError("Description must be at least 10 characters."); return; }

    const subject = `TrueNAS Pulse: ${categoryLabels[category] ?? "Support"}`;
    const body = [description, "", `App version: ${appVersion || "not given"}`].join("\n");
    window.location.href =
      `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    form.classList.add("hidden");
    successPanel.classList.remove("hidden");
  });

  sendAnother?.addEventListener("click", () => {
    form.reset();
    charCount.textContent = "0 / 1800";
    clearError();
    successPanel.classList.add("hidden");
    form.classList.remove("hidden");
  });
</script>
