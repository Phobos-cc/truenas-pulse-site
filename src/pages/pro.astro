---
import BaseLayout from "~/components/BaseLayout.astro";
import Section from "~/components/Section.astro";
import TierCompare from "~/components/TierCompare.astro";
import MotionReveal from "~/components/MotionReveal.astro";
---

<BaseLayout
  title="Pro for TrueNAS Operators"
  description="TrueNAS Pulse Pro is a one-time upgrade for operators managing more TrueNAS SCALE servers, investigating incidents, using fleet view, Server Console, and guarded actions."
>
  <Section
    eyebrow="One purchase. No subscription."
    heading="More servers. More room to investigate."
    headingLevel="h1"
    lede="Monitor up to 8 servers, compare fleet health, trace incidents with longer history, and use advanced guarded controls. A single lifetime purchase; Free remains available without a time limit."
  >
    <TierCompare />
  </Section>

  <Section eyebrow="Why Pro exists" heading="Free stays useful. Pro goes deeper." width="narrow">
    <MotionReveal>
      <div class="space-y-6 text-base leading-relaxed text-text-secondary">
        <p>
          Start with Free for everyday checks: live health, alerts, pool and disk
          visibility, jobs, a Home Screen widget, and one local monitor. Snapshot
          creation and alert acknowledgement are included.
        </p>
        <p>
          Choose Pro when you need to compare servers, investigate an incident
          across longer reporting history, stream logs, or take advanced remote
          actions. Control Mode and confirmation gates still apply; high-risk
          actions also require explicit acknowledgement and biometrics.
        </p>
        <p>
          The one-time purchase funds ongoing development. There is no
          subscription or expiry, and prices are shown in your local currency
          in the app before purchase.
        </p>
      </div>
    </MotionReveal>
  </Section>

  <Section eyebrow="What you actually get" heading="Pro at a glance." width="narrow" tight>
    <MotionReveal>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          [
            "Fleet view across every server",
            "Unlimited proactive monitors",
            "30 days of historical reporting",
            "Live system log streaming",
            "Disk & VDEV management",
            "Snapshot delete, clone, and rollback",
            "Service / app / VM lifecycle",
            "Network, share, and service config",
            "Data protection editing & batch",
            "Server Console — guarded access from your phone",
            "Config backup, restore, support bundle",
            "iCloud Sync · Live Activities · 8 servers",
          ].map((item) => (
            <li class="card flex items-start gap-2.5 rounded-lg border border-stroke-soft bg-surface p-4 text-sm text-text-secondary">
              <span class="mt-1 text-accent">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </MotionReveal>
  </Section>
</BaseLayout>
